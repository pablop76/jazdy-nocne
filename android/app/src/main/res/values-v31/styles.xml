<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Motyw okna w czasie uruchamiania procesu. Aplikacja jest zawsze ciemna,
         więc nie zależy od trybu jasnego ani ciemnego w systemie. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/splash_background</item>
    </style>
    <!-- Motyw okna po uruchomieniu procesu: widać go, zanim Flutter narysuje
         pierwszą klatkę, i pod interfejsem aplikacji. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/splash_background</item>
    </style>
</resources>
